# Entorno
NODE_ENV=development
PORT=3000
API_SECRET=cambiar_este_secreto_por_uno_seguro_en_produccion

# Bots de Telegram (uno por vertical; BotFather)
TELEGRAM_BOT_TOKEN_GASTOS=tu_telegram_bot_token_gastos_aqui
# TELEGRAM_BOT_TOKEN_KIOSCO=tu_telegram_bot_token_kiosco_aqui
# Desarrollo local sin Telegram (solo HTTP/API): TELEGRAM_POLLING=off
# Webhook (staging/producción): Telegram empuja updates al servidor.
# Sin esta URL se usa long polling.
# TELEGRAM_WEBHOOK_URL=https://tu-app.onrender.com
# TELEGRAM_WEBHOOK_SECRET=solo-letras-numeros-_y_-min-16 (generar: openssl rand -hex 24)

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bot_platform?schema=public"

# Proveedor de IA (Texto)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Proveedor de Speech-to-Text (Audio / Voz)
# Opciones: groq (recomendado) | openai | disabled
STT_PROVIDER=groq
STT_API_KEY=tu_groq_api_key_aqui
STT_MODEL=whisper-large-v3-turbo
# STT_BASE_URL=https://api.groq.com/openai/v1

# Negocio: trial y gracia (días)
TRIAL_DAYS=10
GRACE_DAYS=7

# Admin web interno (`/admin`). Sin esta variable la ruta responde 404.
# Mínimo 16 caracteres. Cambiarla invalida todas las sesiones abiertas.
# ADMIN_PASSWORD=generar_password_larga_de_admin_aqui
