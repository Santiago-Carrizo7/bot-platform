generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ CORE ============================

enum BusinessStatus {
  TRIAL
  ACTIVE
  READ_ONLY
  SUSPENDED
}

enum MembershipRole {
  OWNER
  EMPLOYEE
}

enum ConversationPhase {
  IDLE
  COLLECTING
  CONFIRMING
}

model Business {
  id                    String         @id @default(uuid())
  name                  String
  templateId            String
  status                BusinessStatus @default(TRIAL)
  trialStartedAt        DateTime?
  trialDays             Int            @default(10)
  activatedAt           DateTime?
  subscriptionExpiresAt DateTime?
  graceDays             Int            @default(7)
  timezone              String         @default("America/Argentina/Buenos_Aires")
  currency              String         @default("ARS")
  config                Json           @default("{}")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  memberships           Membership[]
  invitations           Invitation[]
  conversations         ConversationState[]
  auditLogs             AuditLog[]
  aiUsage               AiUsageLog[]
  // Tablas del template gastos (referencia). Otros templates agregan las suyas.
  categories            Category[]
  expenses              Expense[]
  budgets               Budget[]
  // Tablas del template kiosco.
  products              Product[]
  sales                 Sale[]
  purchases             Purchase[]
  moneyMovements        MoneyMovement[]
  stockMovements        StockMovement[]

  @@map("businesses")
}

model User {
  id          String       @id @default(uuid())
  telegramId  String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("users")
}

model Membership {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(EMPLOYEE)
  lastUsedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("memberships")
}

model Invitation {
  id              String         @id @default(uuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role            MembershipRole @default(EMPLOYEE)
  tokenHash       String         @unique
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  @@index([businessId])
  @@map("invitations")
}

model ConversationState {
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  phase       ConversationPhase @default(IDLE)
  actionName  String?
  data        Json              @default("{}")
  expiresAt   DateTime?
  updatedAt   DateTime          @updatedAt

  @@id([businessId, userId])
  @@map("conversation_states")
}

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

model AiUsageLog {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  provider    String
  model       String
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("ai_usage_logs")
}

// ==================== TEMPLATE: gastos ====================

model Category {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
  isSystem   Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expenses   Expense[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("categories")
}

model Expense {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String
  amount       Decimal   @db.Decimal(12, 2)
  description  String
  category     String
  categoryId   String?
  categoryRef  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date         DateTime
  installments Int       @default(1)
  currency     String    @default("ARS")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, date])
  @@index([businessId, category])
  @@map("expenses")
}

model Budget {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  category   String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("ARS")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId, category])
  @@index([businessId])
  @@map("budgets")
}

// ==================== TEMPLATE: kiosco ====================

model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  salePrice  Decimal  @db.Decimal(12, 2)
  costPrice  Decimal? @db.Decimal(12, 2)
  stock      Decimal  @db.Decimal(12, 2) @default(0)
  minStock   Decimal? @db.Decimal(12, 2)
  unit       String   @default("unidad")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  saleItems  SaleItem[]
  purchases  Purchase[]
  movements  StockMovement[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
  @@map("products")
}

model Sale {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  total      Decimal    @db.Decimal(12, 2)
  currency   String     @default("ARS")
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      SaleItem[]

  @@index([businessId, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_items")
}

model Purchase {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("ARS")
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Decimal? @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([businessId, date])
  @@map("purchases")
}

model MoneyMovement {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String
  kind         String
  amount       Decimal  @db.Decimal(12, 2)
  concept      String
  category     String?
  date         DateTime
  relatedType  String?
  relatedId    String?
  createdAt    DateTime @default(now())

  @@index([businessId, date])
  @@index([businessId, kind])
  @@map("money_movements")
}

model StockMovement {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  reason      String
  relatedType String?
  relatedId   String?
  userId      String
  createdAt   DateTime @default(now())

  @@index([businessId, productId])
  @@map("stock_movements")
}
