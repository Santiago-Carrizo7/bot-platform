import { describe, expect, it, vi } from 'vitest';
import type {
  RotiseriaProduct,
  RotiseriaPromo,
  RotiseriaSale,
  RotiseriaSaleItem,
  RotiseriaDeliveryZone,
} from '@prisma/client';
